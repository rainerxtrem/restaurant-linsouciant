// Site vitrine du restaurant L'Insouciant (Le Mans).
// Schéma volontairement resserré : un seul restaurant, pas de logique
// d'association / multi-établissements. Le contenu qui bouge (menus, photos,
// horaires, pages légales) est éditable depuis /admin.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  // Accès complet au CMS + gestion des comptes administrateurs.
  SUPER_ADMIN
  // Accès complet au CMS (menus, photos, pages, messages, bons cadeaux,
  // newsletter, réglages) sauf la gestion des autres comptes.
  ADMIN
  // Compte de salle : uniquement la vérification / validation des bons
  // cadeaux (/admin/controle). Aucun accès au CMS.
  VOUCHER_CHECKER
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum MediaType {
  IMAGE
  DOCUMENT
}

enum ContactMessageStatus {
  UNREAD
  READ
  ARCHIVED
}

// Formule (« Entrée + Plat ») ou accord mets & vins (« 3 verres »).
enum MenuPriceKind {
  FORMULA
  WINE_PAIRING
}

enum GiftVoucherStatus {
  // Session Stripe créée mais paiement non confirmé.
  PENDING_PAYMENT
  // Payé, valide.
  ACTIVE
  // Utilisé.
  REDEEMED
  EXPIRED
  // Paiement abandonné / expiré côté Stripe.
  CANCELLED
}

// ---------------------------------------------------------------------------
// Utilisateurs & sécurité
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  uploadedMedia Media[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Médiathèque
// ---------------------------------------------------------------------------

model Media {
  id           String    @id @default(cuid())
  filename     String
  url          String
  storageKey   String    @unique
  type         MediaType @default(IMAGE)
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String?
  altEn        String?
  caption      String?
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  galleryImages     GalleryImage[]
  menuMainFor       Menu[]        @relation("MenuMainImage")
  settingsLogoFor   SiteSetting[] @relation("SettingsLogo")
  settingsFaviconFor SiteSetting[] @relation("SettingsFavicon")
  settingsOgFor     SiteSetting[] @relation("SettingsOgImage")
  settingsHeroFor   SiteSetting[] @relation("SettingsHeroImage")
  settingsAboutFor  SiteSetting[] @relation("SettingsAboutImage")
  announcementFor   Announcement[] @relation("AnnouncementImage")
  themePageHeroFor  ThemePage[]    @relation("ThemePageHero")
  themeProductFor   ThemeProduct[] @relation("ThemeProductImage")
  producerFor       Producer[]     @relation("ProducerImage")
  distinctionFor    Distinction[]  @relation("DistinctionImage")
  settingsHomeMainFor   SiteSetting[] @relation("SettingsHomePhotoMain")
  settingsHomeSecondFor SiteSetting[] @relation("SettingsHomePhotoSecond")

  @@index([type])
  @@map("media")
}

// ---------------------------------------------------------------------------
// Cartes & menus
// ---------------------------------------------------------------------------

model Menu {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  nameEn           String?
  description      String?       @db.Text
  descriptionEn    String?       @db.Text
  // Ex. « Du mardi au vendredi, le midi (hors jours fériés) ».
  availabilityNote   String?
  availabilityNoteEn String?
  mainImageId      String?
  mainImage        Media?        @relation("MenuMainImage", fields: [mainImageId], references: [id], onDelete: SetNull)
  order            Int           @default(0)
  status           PublishStatus @default(DRAFT)
  publishedAt      DateTime?
  // Menu rattaché à une page thématique (ex. menu de Noël) : affiché sur
  // cette page et non sur la carte principale (/menus).
  themePageId      String?
  themePage        ThemePage?    @relation(fields: [themePageId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  prices   MenuPrice[]
  sections MenuSection[]

  @@index([status, order])
  @@map("menus")
}

model MenuPrice {
  id         String        @id @default(cuid())
  menuId     String
  menu       Menu          @relation(fields: [menuId], references: [id], onDelete: Cascade)
  kind       MenuPriceKind @default(FORMULA)
  label      String
  labelEn    String?
  priceCents Int
  order      Int           @default(0)

  @@index([menuId, order])
  @@map("menu_prices")
}

model MenuSection {
  id         String  @id @default(cuid())
  menuId     String
  menu       Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  title      String
  titleEn    String?
  subtitle   String?
  subtitleEn String?
  order      Int     @default(0)

  dishes MenuDish[]

  @@index([menuId, order])
  @@map("menu_sections")
}

model MenuDish {
  id            String      @id @default(cuid())
  sectionId     String
  section       MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name          String
  nameEn        String?
  description    String?     @db.Text
  descriptionEn String?     @db.Text
  order         Int         @default(0)

  @@index([sectionId, order])
  @@map("menu_dishes")
}

// ---------------------------------------------------------------------------
// Galerie photos
// ---------------------------------------------------------------------------

model GalleryAlbum {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  titleEn   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images GalleryImage[]

  @@map("gallery_albums")
}

model GalleryImage {
  id      String       @id @default(cuid())
  albumId String
  album   GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  mediaId String
  media   Media        @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  order   Int          @default(0)

  @@index([albumId, order])
  @@map("gallery_images")
}

// ---------------------------------------------------------------------------
// Pages éditoriales (mentions légales, confidentialité, cookies, CGV…)
// ---------------------------------------------------------------------------

model Page {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  titleEn        String?
  content        String        @db.Text
  contentEn      String?       @db.Text
  status         PublishStatus @default(DRAFT)
  publishedAt    DateTime?
  // true = page structurelle (liée dans le pied de page), non supprimable.
  isSystem       Boolean       @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("pages")
}

// ---------------------------------------------------------------------------
// Formulaire de contact
// ---------------------------------------------------------------------------

model ContactMessage {
  id          String               @id @default(cuid())
  fullName    String
  email       String
  phone       String?
  subject     String?
  message     String               @db.Text
  consentGdpr Boolean              @default(false)
  status      ContactMessageStatus @default(UNREAD)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime             @default(now())

  @@index([status, createdAt])
  @@map("contact_messages")
}

// ---------------------------------------------------------------------------
// Newsletter (double opt-in maison)
// ---------------------------------------------------------------------------

model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  locale           String    @default("fr")
  confirmToken     String    @unique
  confirmedAt      DateTime?
  unsubscribeToken String    @unique
  unsubscribedAt   DateTime?
  createdAt        DateTime  @default(now())

  @@map("newsletter_subscribers")
}

// ---------------------------------------------------------------------------
// Bons cadeaux
// ---------------------------------------------------------------------------

model GiftVoucher {
  id                    String            @id @default(cuid())
  code                  String            @unique
  amountCents           Int
  status                GiftVoucherStatus @default(PENDING_PAYMENT)

  buyerName      String
  buyerEmail     String
  recipientName  String?
  recipientEmail String?
  message        String? @db.Text
  // Description lisible quand le bon a été composé à partir de menus
  // (ex. « 1 × Menus Plaisir — 4 plats · 2 × Menu Premier Pas — Entrée + Plat »).
  selectionLabel String? @db.Text

  stripeSessionId       String? @unique
  stripePaymentIntentId String?

  issuedAt      DateTime?
  expiresAt     DateTime?
  redeemedAt    DateTime?
  // Nom du compte qui a validé le bon en salle (traçabilité).
  redeemedByName String?
  pdfStorageKey String?
  // Relance « votre bon expire bientôt » : horodatée une seule fois par bon.
  expiryReminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("gift_vouchers")
}

// ---------------------------------------------------------------------------
// Réglages du site (singleton)
// ---------------------------------------------------------------------------

model SiteSetting {
  id String @id @default("singleton")

  siteName    String  @default("L'Insouciant")
  siteNameEn  String?
  tagline     String  @default("Gastronomie décomplexée")
  taglineEn   String?
  intro       String? @db.Text
  introEn     String? @db.Text

  addressLine String  @default("")
  postalCode  String  @default("")
  city        String  @default("")
  phone       String  @default("")
  email       String  @default("")

  // [{ day, closed, slots: [{ start, end }] }]
  openingHours Json?

  parkingNote    String?
  parkingNoteEn  String?
  servicesNote   String? @db.Text
  servicesNoteEn String? @db.Text
  paymentNote    String? @db.Text
  paymentNoteEn  String? @db.Text

  zenchefBookingUrl    String?
  zenchefNewsletterUrl String?
  // Identifiant du restaurant côté Zenchef (widget d'embed « rid »).
  zenchefRestaurantId  String?

  facebookUrl  String?
  instagramUrl String?
  googleMapsUrl String?
  mapEmbedUrl  String? @db.Text

  logoId    String?
  logo      Media?  @relation("SettingsLogo", fields: [logoId], references: [id], onDelete: SetNull)
  faviconId String?
  favicon   Media?  @relation("SettingsFavicon", fields: [faviconId], references: [id], onDelete: SetNull)
  ogImageId String?
  ogImage   Media?  @relation("SettingsOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  heroImageId String?
  heroImage   Media? @relation("SettingsHeroImage", fields: [heroImageId], references: [id], onDelete: SetNull)
  // Vidéo de fond de la page d'accueil (URL d'un MP4/WebM). L'image
  // heroImage sert de poster / repli.
  heroVideoUrl String? @db.Text
  aboutImageId String?
  aboutImage   Media? @relation("SettingsAboutImage", fields: [aboutImageId], references: [id], onDelete: SetNull)
  // Section « En images » de l'accueil : grande photo + petite superposée.
  // Vides = repli sur les albums « Le restaurant » / « Les plats ».
  homePhotoMainId   String?
  homePhotoMain     Media?  @relation("SettingsHomePhotoMain", fields: [homePhotoMainId], references: [id], onDelete: SetNull)
  homePhotoSecondId String?
  homePhotoSecond   Media?  @relation("SettingsHomePhotoSecond", fields: [homePhotoSecondId], references: [id], onDelete: SetNull)

  // Pages désactivées (retirées de la navigation, 404, hors sitemap) :
  // clés de src/lib/site-pages.ts (house, menus, photos, contact, book).
  disabledPages String[] @default([])
  // Ordre des liens du menu et du pied de page (clés de NAV_ORDER_KEYS,
  // src/lib/site-pages.ts). Vide = ordre par défaut.
  navOrder      String[] @default([])

  legalCompanyName         String?
  legalSiret               String?
  legalCapital             String?
  legalPublicationDirector String?
  legalHost                String? @db.Text
  legalRcsCity             String?
  legalVatNumber           String?

  seoDefaultTitle       String?
  seoDefaultDescription String?

  footerText   String? @db.Text
  footerTextEn String? @db.Text

  // Distinctions / presse affichées en bande discrète dans le pied de page,
  // une par ligne (ex. « Guide MICHELIN », « Gault&Millau »).
  pressMentions String? @db.Text

  // Libellé de la carte du moment, affiché sur /menus
  // (ex. « Carte d'automne · novembre 2026 »). Vide = non affiché.
  menusSeasonLabel   String?
  menusSeasonLabelEn String?

  // Page publique « Bons cadeaux » activée (sinon 404 + retirée des menus).
  giftVouchersEnabled Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ---------------------------------------------------------------------------
// Annonce / pop-up d'accueil (singleton) — planifiée entre deux dates,
// contenu entièrement éditable (image + texte riche + bouton).
// ---------------------------------------------------------------------------

model Announcement {
  id            String    @id @default("singleton")
  enabled       Boolean   @default(false)
  startsAt      DateTime?
  endsAt        DateTime?
  imageId       String?
  image         Media?    @relation("AnnouncementImage", fields: [imageId], references: [id], onDelete: SetNull)
  content       String    @default("") @db.Text
  contentEn     String?   @db.Text
  buttonLabel   String?
  buttonLabelEn String?
  buttonUrl     String?
  // Jours pendant lesquels le pop-up reste masqué après fermeture par le
  // visiteur (stocké côté navigateur).
  dismissDays   Int       @default(7)
  updatedAt     DateTime  @updatedAt

  @@map("announcements")
}

// ---------------------------------------------------------------------------
// Pages thématiques (Noël, Pâques, traiteur à emporter…) : présentation +
// encadrés produits (photo, description, tarifs) + menus rattachés.
// Servies à la racine (/<slug>), ajoutées au menu du site quand activées.
// ---------------------------------------------------------------------------

model ThemePage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  titleEn     String?
  // Libellé court dans le menu du site (par défaut : le titre).
  navLabel    String?
  navLabelEn  String?
  intro       String?  @db.Text
  introEn     String?  @db.Text
  // Modalités de commande / retrait (dates limites, créneaux…).
  orderInfo   String?  @db.Text
  orderInfoEn String?  @db.Text
  // Module de commande / réservation en ligne (ex. Zenchef click & collect),
  // ouvert en plein écran par le bouton « Commander en ligne ».
  orderUrl    String?  @db.Text
  heroImageId String?
  heroImage   Media?   @relation("ThemePageHero", fields: [heroImageId], references: [id], onDelete: SetNull)
  enabled     Boolean  @default(false)
  // Ambiance visuelle : "classic" (charte du site) ou "christmas" (fêtes).
  style       String   @default("classic")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products ThemeProduct[]
  menus    Menu[]

  @@index([enabled, order])
  @@map("theme_pages")
}

model ThemeProduct {
  id            String    @id @default(cuid())
  themePageId   String
  themePage     ThemePage @relation(fields: [themePageId], references: [id], onDelete: Cascade)
  name          String
  nameEn        String?
  description   String?   @db.Text
  descriptionEn String?   @db.Text
  imageId       String?
  image         Media?    @relation("ThemeProductImage", fields: [imageId], references: [id], onDelete: SetNull)
  // [{ label, labelEn, priceCents }] — ex. « Le lobe entier (500 g) » 65 €.
  prices        Json      @default("[]")
  order         Int       @default(0)

  @@index([themePageId, order])
  @@map("theme_products")
}

// ---------------------------------------------------------------------------
// Producteurs partenaires (section « Nos producteurs » de /la-maison).
// ---------------------------------------------------------------------------

model Producer {
  id            String  @id @default(cuid())
  name          String
  // Métier / produit : « Maraîcher », « Éleveur de volailles »…
  craft         String?
  craftEn       String?
  location      String?
  description   String? @db.Text
  descriptionEn String? @db.Text
  imageId       String?
  image         Media?  @relation("ProducerImage", fields: [imageId], references: [id], onDelete: SetNull)
  url           String?
  order         Int     @default(0)

  @@index([order])
  @@map("producers")
}

// ---------------------------------------------------------------------------
// Distinctions et presse (bande du pied de page). Logo facultatif : fichier
// officiel fourni par le guide ; sinon rendu typographique.
// ---------------------------------------------------------------------------

model Distinction {
  id       String  @id @default(cuid())
  name     String
  detail   String?
  detailEn String?
  imageId  String?
  image    Media?  @relation("DistinctionImage", fields: [imageId], references: [id], onDelete: SetNull)
  url      String?
  order    Int     @default(0)

  @@index([order])
  @@map("distinctions")
}

// ---------------------------------------------------------------------------
// Contenu éditable des pages du site (Pages → page du site). Une ligne par
// page ; `data` = { [champ]: { fr?, en? } | { mediaId } }. Les champs sont
// définis dans src/lib/content/pages.ts ; un champ absent = texte par défaut.
// ---------------------------------------------------------------------------

model PageContent {
  key       String   @id
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt

  @@map("page_contents")
}
