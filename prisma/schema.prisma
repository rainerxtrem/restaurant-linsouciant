// Site vitrine du restaurant L'Insouciant (Le Mans).
// Schéma volontairement resserré : un seul restaurant, pas de logique
// d'association / multi-établissements. Le contenu qui bouge (menus, photos,
// horaires, pages légales) est éditable depuis /admin.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  // Accès complet au CMS + gestion des comptes administrateurs.
  SUPER_ADMIN
  // Accès complet au CMS (menus, photos, pages, messages, bons cadeaux,
  // newsletter, réglages) sauf la gestion des autres comptes.
  ADMIN
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum MediaType {
  IMAGE
  DOCUMENT
}

enum ContactMessageStatus {
  UNREAD
  READ
  ARCHIVED
}

// Formule (« Entrée + Plat ») ou accord mets & vins (« 3 verres »).
enum MenuPriceKind {
  FORMULA
  WINE_PAIRING
}

enum GiftVoucherStatus {
  // Session Stripe créée mais paiement non confirmé.
  PENDING_PAYMENT
  // Payé, valide.
  ACTIVE
  // Utilisé.
  REDEEMED
  EXPIRED
  // Paiement abandonné / expiré côté Stripe.
  CANCELLED
}

// ---------------------------------------------------------------------------
// Utilisateurs & sécurité
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  uploadedMedia Media[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Médiathèque
// ---------------------------------------------------------------------------

model Media {
  id           String    @id @default(cuid())
  filename     String
  url          String
  storageKey   String    @unique
  type         MediaType @default(IMAGE)
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String?
  altEn        String?
  caption      String?
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  galleryImages     GalleryImage[]
  menuMainFor       Menu[]        @relation("MenuMainImage")
  settingsLogoFor   SiteSetting[] @relation("SettingsLogo")
  settingsFaviconFor SiteSetting[] @relation("SettingsFavicon")
  settingsOgFor     SiteSetting[] @relation("SettingsOgImage")
  settingsHeroFor   SiteSetting[] @relation("SettingsHeroImage")
  settingsAboutFor  SiteSetting[] @relation("SettingsAboutImage")

  @@index([type])
  @@map("media")
}

// ---------------------------------------------------------------------------
// Cartes & menus
// ---------------------------------------------------------------------------

model Menu {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  nameEn           String?
  description      String?       @db.Text
  descriptionEn    String?       @db.Text
  // Ex. « Du mardi au vendredi, le midi (hors jours fériés) ».
  availabilityNote   String?
  availabilityNoteEn String?
  mainImageId      String?
  mainImage        Media?        @relation("MenuMainImage", fields: [mainImageId], references: [id], onDelete: SetNull)
  order            Int           @default(0)
  status           PublishStatus @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  prices   MenuPrice[]
  sections MenuSection[]

  @@index([status, order])
  @@map("menus")
}

model MenuPrice {
  id         String        @id @default(cuid())
  menuId     String
  menu       Menu          @relation(fields: [menuId], references: [id], onDelete: Cascade)
  kind       MenuPriceKind @default(FORMULA)
  label      String
  labelEn    String?
  priceCents Int
  order      Int           @default(0)

  @@index([menuId, order])
  @@map("menu_prices")
}

model MenuSection {
  id         String  @id @default(cuid())
  menuId     String
  menu       Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  title      String
  titleEn    String?
  subtitle   String?
  subtitleEn String?
  order      Int     @default(0)

  dishes MenuDish[]

  @@index([menuId, order])
  @@map("menu_sections")
}

model MenuDish {
  id            String      @id @default(cuid())
  sectionId     String
  section       MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name          String
  nameEn        String?
  description    String?     @db.Text
  descriptionEn String?     @db.Text
  order         Int         @default(0)

  @@index([sectionId, order])
  @@map("menu_dishes")
}

// ---------------------------------------------------------------------------
// Galerie photos
// ---------------------------------------------------------------------------

model GalleryAlbum {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  titleEn   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images GalleryImage[]

  @@map("gallery_albums")
}

model GalleryImage {
  id      String       @id @default(cuid())
  albumId String
  album   GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  mediaId String
  media   Media        @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  order   Int          @default(0)

  @@index([albumId, order])
  @@map("gallery_images")
}

// ---------------------------------------------------------------------------
// Pages éditoriales (mentions légales, confidentialité, cookies, CGV…)
// ---------------------------------------------------------------------------

model Page {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  titleEn        String?
  content        String        @db.Text
  contentEn      String?       @db.Text
  status         PublishStatus @default(DRAFT)
  publishedAt    DateTime?
  // true = page structurelle (liée dans le pied de page), non supprimable.
  isSystem       Boolean       @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("pages")
}

// ---------------------------------------------------------------------------
// Formulaire de contact
// ---------------------------------------------------------------------------

model ContactMessage {
  id          String               @id @default(cuid())
  fullName    String
  email       String
  phone       String?
  subject     String?
  message     String               @db.Text
  consentGdpr Boolean              @default(false)
  status      ContactMessageStatus @default(UNREAD)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime             @default(now())

  @@index([status, createdAt])
  @@map("contact_messages")
}

// ---------------------------------------------------------------------------
// Newsletter (double opt-in maison)
// ---------------------------------------------------------------------------

model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  locale           String    @default("fr")
  confirmToken     String    @unique
  confirmedAt      DateTime?
  unsubscribeToken String    @unique
  unsubscribedAt   DateTime?
  createdAt        DateTime  @default(now())

  @@map("newsletter_subscribers")
}

// ---------------------------------------------------------------------------
// Bons cadeaux
// ---------------------------------------------------------------------------

model GiftVoucher {
  id                    String            @id @default(cuid())
  code                  String            @unique
  amountCents           Int
  status                GiftVoucherStatus @default(PENDING_PAYMENT)

  buyerName      String
  buyerEmail     String
  recipientName  String?
  recipientEmail String?
  message        String? @db.Text

  stripeSessionId       String? @unique
  stripePaymentIntentId String?

  issuedAt      DateTime?
  expiresAt     DateTime?
  redeemedAt    DateTime?
  pdfStorageKey String?
  // Relance « votre bon expire bientôt » : horodatée une seule fois par bon.
  expiryReminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("gift_vouchers")
}

// ---------------------------------------------------------------------------
// Réglages du site (singleton)
// ---------------------------------------------------------------------------

model SiteSetting {
  id String @id @default("singleton")

  siteName    String  @default("L'Insouciant")
  siteNameEn  String?
  tagline     String  @default("Gastronomie décomplexée")
  taglineEn   String?
  intro       String? @db.Text
  introEn     String? @db.Text

  addressLine String  @default("")
  postalCode  String  @default("")
  city        String  @default("")
  phone       String  @default("")
  email       String  @default("")

  // [{ day, closed, slots: [{ start, end }] }]
  openingHours Json?

  parkingNote    String?
  parkingNoteEn  String?
  servicesNote   String? @db.Text
  servicesNoteEn String? @db.Text
  paymentNote    String? @db.Text
  paymentNoteEn  String? @db.Text

  zenchefBookingUrl    String?
  zenchefNewsletterUrl String?
  // Identifiant du restaurant côté Zenchef (widget d'embed « rid »).
  zenchefRestaurantId  String?

  facebookUrl  String?
  instagramUrl String?
  googleMapsUrl String?
  mapEmbedUrl  String? @db.Text

  logoId    String?
  logo      Media?  @relation("SettingsLogo", fields: [logoId], references: [id], onDelete: SetNull)
  faviconId String?
  favicon   Media?  @relation("SettingsFavicon", fields: [faviconId], references: [id], onDelete: SetNull)
  ogImageId String?
  ogImage   Media?  @relation("SettingsOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  heroImageId String?
  heroImage   Media? @relation("SettingsHeroImage", fields: [heroImageId], references: [id], onDelete: SetNull)
  aboutImageId String?
  aboutImage   Media? @relation("SettingsAboutImage", fields: [aboutImageId], references: [id], onDelete: SetNull)

  legalCompanyName         String?
  legalSiret               String?
  legalCapital             String?
  legalPublicationDirector String?
  legalHost                String? @db.Text
  legalRcsCity             String?
  legalVatNumber           String?

  seoDefaultTitle       String?
  seoDefaultDescription String?

  footerText   String? @db.Text
  footerTextEn String? @db.Text

  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
