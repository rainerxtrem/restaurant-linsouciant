# Variables à définir sur le service Railway (onglet Variables).
# DATABASE_URL est fournie automatiquement par le plugin PostgreSQL — ne pas
# la saisir à la main, la référencer : ${{Postgres.DATABASE_URL}}

DATABASE_URL=${{Postgres.DATABASE_URL}}

AUTH_SECRET=                       # openssl rand -base64 32
NEXTAUTH_URL=https://restaurant-linsouciant.fr
NEXT_PUBLIC_SITE_URL=https://restaurant-linsouciant.fr
NEXT_PUBLIC_SITE_NAME=L'Insouciant

# Emails (Resend)
RESEND_API_KEY=
MAIL_FROM=L'Insouciant <contact@restaurant-linsouciant.fr>
CONTACT_NOTIFICATION_EMAIL=restaurant-linsouciant@orange.fr

# Stockage médias — Cloudflare R2 recommandé (un volume Railway ne suit pas
# les redéploiements multi-région et complique les sauvegardes).
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=linsouciant-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://media.restaurant-linsouciant.fr
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.restaurant-linsouciant.fr

# Paiement (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Tâches planifiées (GitHub Actions)
CRON_SECRET=

# Mesure d'audience (facultatif)
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Compte admin initial (utilisé une seule fois par le seed)
SEED_ADMIN_EMAIL=admin@restaurant-linsouciant.fr
SEED_ADMIN_PASSWORD=

# Réservation Zenchef — API serveur (le widget client utilise seulement le rid)
ZENCHEF_API_KEY=
