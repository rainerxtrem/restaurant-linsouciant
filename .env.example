# ====================================================================
# Restaurant L'Insouciant — variables d'environnement
# Copier en .env pour le dev local. En production : voir railway/README.md
# ====================================================================

# --- Base de données (PostgreSQL) ---
# Railway : fournie automatiquement par le plugin PostgreSQL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/linsouciant?schema=public"

# --- Authentification (NextAuth / Auth.js) ---
# Générer : npx auth secret   (ou : openssl rand -base64 32)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Site public ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="L'Insouciant"

# --- Emails (Resend, API HTTP) — notifications de contact + newsletter + bons cadeaux ---
RESEND_API_KEY=""
MAIL_FROM="L'Insouciant <contact@restaurant-linsouciant.fr>"
CONTACT_NOTIFICATION_EMAIL="restaurant-linsouciant@orange.fr"

# --- Stockage des médias ---
# "local" : écrit dans ./storage/uploads (volume en prod).
# "s3"    : stockage compatible S3 / Cloudflare R2 (recommandé sur Railway).
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage/uploads"
NEXT_PUBLIC_MEDIA_BASE_URL="http://localhost:3000/media"

S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# --- Paiement (Stripe) — achat de bons cadeaux en ligne ---
STRIPE_SECRET_KEY=""
# Stripe Dashboard > Developers > Webhooks, endpoint /api/webhooks/stripe,
# événement "checkout.session.completed".
STRIPE_WEBHOOK_SECRET=""

# --- Tâches planifiées (GitHub Actions) — relances bons cadeaux avant expiration ---
CRON_SECRET=""

# --- Mesure d'audience (Umami, auto-hébergé — facultatif) ---
NEXT_PUBLIC_UMAMI_SCRIPT_URL=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# --- Compte administrateur initial (prisma/seed.ts) ---
SEED_ADMIN_EMAIL="admin@restaurant-linsouciant.fr"
SEED_ADMIN_PASSWORD="ChangeMoiAuPremierLancement1"

# --- Réservation Zenchef ---
# Le widget de réservation (SDK client) n'a besoin que du "rid" du
# restaurant (réglage zenchefRestaurantId, éditable dans /admin). Ce token
# est pour l'API Zenchef (accès serveur aux réservations/disponibilités) —
# réservé à d'éventuelles fonctionnalités futures.
ZENCHEF_API_KEY=""
